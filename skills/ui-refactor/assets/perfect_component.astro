---
const { title, subtitle, ctaHref, ctaLabel } = Astro.props;
---

<section class="mx-auto w-full max-w-5xl px-6 py-16">
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <p class="text-sm uppercase tracking-widest text-gray-400">Featured</p>
      <h2 class="mt-2 text-3xl font-semibold text-gray-100 md:text-4xl">
        {title}
      </h2>
      <p class="mt-3 text-base text-gray-300 md:text-lg">
        {subtitle}
      </p>
    </div>
    <a
      href={ctaHref}
      class="inline-flex items-center justify-center rounded-full bg-indigo-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-indigo-400"
    >
      {ctaLabel}
    </a>
  </div>
</section>
