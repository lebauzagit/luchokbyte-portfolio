---
import type { CollectionEntry } from 'astro:content';
import { defaultLang } from '../i18n/ui';
import ProjectImage from './ProjectImage.astro';

interface Props {
	project: CollectionEntry<'work'>;
	lang?: string;
}

const { project, lang } = Astro.props;
const { data, id, slug } = project;
const rawSlug = slug ?? id;
const normalizedSlug = lang && rawSlug.startsWith(`${lang}/`)
	? rawSlug.slice(lang.length + 1)
	: rawSlug;
const prefix = lang && lang !== defaultLang ? `/${lang}` : '';
const href = `${prefix}/work/${normalizedSlug}`;

---

<a class="card" href={href}>
	<ProjectImage src={data.img} alt={data.img_alt || ''} />
	<span class="title">{data.title}</span>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 11rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: transform 0.3s ease, box-shadow var(--theme-transition);
	}

	.card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-md);
	}

	picture {
		flex: 1;
		min-height: 0;
	}

	.project-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.title {
		padding: 0.75rem 1rem;
		/* background: var(--gray-999); */
		color: var(--gray-200);
		flex-shrink: 0;
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}
	}
</style>
