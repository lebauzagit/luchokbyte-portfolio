---
import Hero from './Hero.astro';
import Icon from './Icon.astro';

interface AboutCard {
	icon: keyof typeof import('./IconPaths').iconPaths;
	title: string;
	content: string | string[];
}

interface AboutProps {
	title: string;
	tagline: string;
	cards: AboutCard[];
	photo?: {
		src: string;
		alt: string;
		overlayText?: string;
		width?: string;
	};
}

const { title, tagline, cards, photo } = Astro.props as AboutProps;
---

<main class="about">
	<Hero title={title} tagline={tagline} />

	<section class="about-cards">
		{cards.map((card) => (
			<div class="about-card">
				<div class="card-icon">
					<Icon icon={card.icon} color="var(--accent-regular)" size="2.5rem" />
				</div>
				<h3 class="card-title">{card.title}</h3>
				<div class="card-content">
					{Array.isArray(card.content) ? (
						<>
							{card.content.map((paragraph) => (
								<p set:html={paragraph}></p>
							))}
						</>
					) : (
						<p set:html={card.content}></p>
					)}
				</div>
			</div>
		))}
	</section>

	{photo && (
		<section class="about-photo">
			<div class="photo-container">
				<img
					width={photo.width || "800px"}
					src={photo.src}
					alt={photo.alt}
				/>
				{photo.overlayText && (
					<div class="photo-overlay">
						<p>{photo.overlayText}</p>
					</div>
				)}
			</div>
		</section>
	)}
</main>

<style>
	/* About Cards Styling */
	.about-cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		margin: 3rem 0;
	}

	.about-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
		padding: 2rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		background: rgba(255, 255, 255, 0.02);
		backdrop-filter: blur(10px);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.card-icon {
		margin-bottom: 1.5rem;
		padding: 1rem;
		border-radius: 50%;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-md);
	}

	.card-title {
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--gray-0);
		margin-bottom: 1rem;
	}

	.card-content {
		color: var(--gray-300);
		line-height: 1.6;
		text-align: left;
	}

	.card-content p {
		margin-bottom: 1rem;
	}

	.card-content p:last-child {
		margin-bottom: 0;
	}

	.card-content strong {
		color: var(--accent-regular);
		font-weight: 600;
	}

	/* About Photo Section */
	.about-photo {
		margin-top: 3rem;
		display: flex;
		justify-content: center;
	}

	.photo-container {
		position: relative;
		border-radius: 1.5rem;
		overflow: hidden;
		box-shadow: var(--shadow-xl);
		max-width: 800px;
	}

	.photo-container img {
		width: 100%;
		height: auto;
		display: block;
	}

	.photo-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
		padding: 2rem 1.5rem 1.5rem;
		color: white;
	}

	.photo-overlay p {
		font-style: italic;
		font-size: var(--text-lg);
		margin: 0;
		text-align: center;
	}

	@media (min-width: 50em) {
		.about-cards {
			grid-template-columns: repeat(2, 1fr);
			gap: 3rem;
		}

		.about-card {
			padding: 2.5rem;
		}

		.card-title {
			font-size: var(--text-2xl);
		}
	}

	@media (min-width: 60em) {
		.about-cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
