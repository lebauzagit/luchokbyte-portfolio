---
// Contact form component for collaboration requests
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="contact-form-section">
	<form
		target="_blank"
		action="https://formsubmit.co/lebauzagit@gmail.com"
		method="POST"
        class="contact-form"
	>
		<div class="form-group">
			<div class="form-row">
				<div class="col">
                    <label for="name">{t('contact.name')} <span class="required">*</span></label>
					<input
						type="text"
						name="name"
						class="form-control"
						placeholder={t('contact.placeholder.name')}
						required
					/>
				</div>
				<div class="col">
                    <label for="email">{t('contact.email')} <span class="required">*</span></label>
					<input
						type="email"
						name="email"
						class="form-control"
						placeholder={t('contact.placeholder.email')}
						required
					/>
				</div>
			</div>
		</div>
		<div class="form-group">
            <label for="message">{t('contact.message')} <span class="required">*</span></label>
			<textarea
				placeholder={t('contact.placeholder.message')}
				class="form-control"
				name="message"
				rows="10"
				required></textarea>
		</div>
		<button type="submit" class="submit-btn"
			>{t('contact.send')}</button
		>
	</form>
