---
export interface Props {
	lang: 'en' | 'es';
	size?: string;
}

const { lang, size = '1.5rem' } = Astro.props;
---

{lang === 'en' ? (
	<svg class="flag-icon" width={size} height={size} viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
		<rect width="32" height="32" fill="#012169" rx="2"/>
		<path d="M0 0 L32 21.33 M32 0 L0 21.33 M0 32 L32 10.67 M32 32 L0 10.67" stroke="#fff" stroke-width="6"/>
		<path d="M0 0 L32 21.33 M32 0 L0 21.33 M0 32 L32 10.67 M32 32 L0 10.67" stroke="#C8102E" stroke-width="4" clip-path="inset(0)"/>
		<path d="M16 0 v32 M0 16 h32" stroke="#fff" stroke-width="10.667"/>
		<path d="M16 0 v32 M0 16 h32" stroke="#C8102E" stroke-width="6.4"/>
	</svg>
) : (
	<svg class="flag-icon" width={size} height={size} viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
		<rect width="32" height="32" fill="#AA151B" rx="2"/>
		<rect y="8" width="32" height="16" fill="#F1BF00"/>
	</svg>
)}

<style>
	.flag-icon {
		display: inline-block;
		overflow: visible;
		border: none;
	}
</style>
