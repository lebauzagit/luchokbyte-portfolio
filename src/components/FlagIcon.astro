---
export interface Props {
	lang: 'en' | 'es';
	size?: string;
}

const { lang, size = '1.5rem' } = Astro.props;
---

{lang === 'en' ? (
	<svg 
		class="flag-icon" 
		width={size} 
		height={size} 
		viewBox="0 0 28 28" 
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<!-- Clip to circle -->
		<defs>
			<clipPath id="clip-circle">
			<circle cx="14" cy="14" r="13" />
			</clipPath>
		</defs>
		<!-- Outer circle -->
  		<circle cx="14" cy="14" r="13" />
		<g clip-path="url(#clip-circle)">
			<!-- Horizontal stripes -->
			<line x1="0" y1="6"  x2="28" y2="6" />
			<line x1="0" y1="9"  x2="28" y2="9" />
			<line x1="0" y1="12" x2="28" y2="12" />
			<line x1="0" y1="15" x2="28" y2="15" />
			<line x1="0" y1="18" x2="28" y2="18" />
			<line x1="0" y1="21" x2="28" y2="21" />
			<!-- Canton -->
			<rect x="0" y="6" width="12" height="9" />
			<!-- Stars (slightly more vertical spacing) -->
			<circle cx="4" cy="7.6"  r="0.45" />
			<circle cx="6" cy="7.6"  r="0.45" />
			<circle cx="8" cy="7.6"  r="0.45" />

			<circle cx="4" cy="10.3" r="0.45" />
			<circle cx="6" cy="10.3" r="0.45" />
			<circle cx="8" cy="10.3" r="0.45" />

			<circle cx="4" cy="13.0" r="0.45" />
			<circle cx="6" cy="13.0" r="0.45" />
			<circle cx="8" cy="13.0" r="0.45" />
		</g>
	</svg>
) : (
	<svg 
		class="flag-icon" 
		width={size} 
		height={size} 
		viewBox="0 0 28 28" 
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<!-- Rounded rectangle outline -->
		<!-- Clip to circle -->
		<defs>
			<clipPath id="clip-circle-es">
			<circle cx="14" cy="14" r="13" />
			</clipPath>
		</defs>

		<!-- Outer circle -->
		<circle cx="14" cy="14" r="13" />

		<!-- Flag content -->
		<g clip-path="url(#clip-circle-es)">
			<!-- Top stripe -->
			<line x1="0" y1="7" x2="28" y2="7" />
			<line x1="0" y1="9" x2="28" y2="9" />

			<!-- Bottom stripe -->
			<line x1="0" y1="19" x2="28" y2="19" />
			<line x1="0" y1="21" x2="28" y2="21" />

			<!-- Simplified coat of arms (iconic, stroke-only) -->
			<rect x="6" y="11" width="3.5" height="4.5" rx="0.6" />
			<line x1="6" y1="12.5" x2="9.5" y2="12.5" />
			<line x1="7.75" y1="11" x2="7.75" y2="15.5" />
		</g>
	</svg>
)}

<style>
	.flag-icon {
		display: inline-block;
		overflow: visible;
		border: none;
		color: var(--accent-dark);
		transition: color var(--theme-transition);
	}

	.flag-icon:hover {
		color: var(--accent-text-over);
	}
</style>

