---
export interface Props {
	lang: 'en' | 'es';
	size?: string;
}

const { lang, size = '1.5rem' } = Astro.props;
---

{lang === 'en' ? (
	<svg class="flag-icon" width={size} height={size} viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
		<!-- Rounded rectangle outline -->
		<rect x="2" y="2" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" rx="6"/>
		<!-- Union Jack simplified outline -->
		<path d="M 8 8 L 24 24 M 24 8 L 8 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
		<path d="M16 8 v16 M8 16 h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
	</svg>
) : (
	<svg class="flag-icon" width={size} height={size} viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
		<!-- Rounded rectangle outline -->
		<rect x="2" y="2" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" rx="6"/>
		<!-- Spanish flag horizontal stripes outline -->
		<line x1="4" y1="12" x2="28" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
		<line x1="4" y1="20" x2="28" y2="20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
	</svg>
)}

<style>
	.flag-icon {
		display: inline-block;
		overflow: visible;
		border: none;
		color: var(--accent-dark);
		transition: color var(--theme-transition);
	}

	.flag-icon:hover {
		color: var(--accent-text-over);
	}
</style>
