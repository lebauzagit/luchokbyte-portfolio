---
import Hero from './Hero.astro';
import Icon from './Icon.astro';

interface CardItem {
	icon?: keyof typeof import('./IconPaths').iconPaths;
	title: string;
	content: string | string[];
}

interface GenericCardProps {
	// Hero section (optional)
	title?: string;
	tagline?: string;

	// Cards section
	cards: CardItem[];

	// Photo/Media section (optional)
	photo?: {
		src: string;
		alt: string;
		overlayText?: string;
		width?: string;
	};

	// Customization options
	sectionClass?: string;
	cardsClass?: string;
	gridColumns?: number;
	showIcons?: boolean;
}
---

<main class:list={['generic-section', Astro.props.sectionClass]}>
	{ Astro.props.title && (
		<Hero title={Astro.props.title} tagline={Astro.props.tagline || ''} />
	)}

	<section class:list={['cards-grid', Astro.props.cardsClass]} style={`--grid-columns: ${Astro.props.gridColumns || 1}`}>
		{Astro.props.cards.map((card: CardItem) => (
			<div class="card-item">
				{ (Astro.props.showIcons !== false && card.icon) && (
					<div class="card-icon">
						<Icon icon={card.icon} color="var(--accent-regular)" size="2.5rem" />
					</div>
				)}
				<h3 class="card-title">{card.title}</h3>
				<div class="card-content">
					{Array.isArray(card.content) ? (
						<>
							{card.content.map((paragraph: string) => (
								<p set:html={paragraph}></p>
							))}
						</>
					) : (
						<p set:html={card.content}></p>
					)}
				</div>
			</div>
		))}
	</section>

	{Astro.props.photo && (
		<section class="media-section mb-8!">
			<div class="media-container">
				<img
					width={Astro.props.photo.width || "800px"}
					src={Astro.props.photo.src}
					alt={Astro.props.photo.alt}
				/>
				{Astro.props.photo.overlayText && (
					<div class="media-overlay">
						<p>{Astro.props.photo.overlayText}</p>
					</div>
				)}
			</div>
		</section>
	)}
</main>

<style>
	/* Generic Cards Grid */
	.cards-grid {
		display: grid;
		grid-template-columns: repeat(var(--grid-columns, 1), 1fr);
		gap: 2rem;
		margin: 3rem 0;
	}

	.card-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
		padding: 2rem;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		background: rgba(255, 255, 255, 0.02);
		backdrop-filter: blur(10px);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.card-icon {
		margin-bottom: 1.5rem;
		padding: 1rem;
		border-radius: 50%;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-md);
	}

	.card-title {
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--gray-0);
		margin-bottom: 1rem;
	}

	.card-content {
		color: var(--gray-300);
		line-height: 1.6;
		text-align: left;
	}

	.card-content p {
		margin-bottom: 1rem;
	}

	.card-content p:last-child {
		margin-bottom: 0;
	}

	.card-content strong {
		color: var(--accent-regular);
		font-weight: 600;
	}

	/* Media Section */
	.media-section {
		margin-top: 3rem;
		display: flex;
		justify-content: center;
	}

	.media-container {
		position: relative;
		border-radius: 1.5rem;
		overflow: hidden;
		box-shadow: var(--shadow-xl);
		max-width: 800px;
	}

	.media-container img {
		width: 100%;
		height: auto;
		display: block;
	}

	.media-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
		padding: 2rem 1.5rem 1.5rem;
		color: white;
	}

	.media-overlay p {
		font-style: italic;
		font-size: var(--text-lg);
		margin: 0;
		text-align: center;
	}

	/* Responsive Design */
	@media (min-width: 50em) {
		.cards-grid {
			gap: 3rem;
		}

		.card-item {
			padding: 2.5rem;
		}

		.card-title {
			font-size: var(--text-2xl);
		}
	}

	@media (min-width: 60em) {
		/* Allow for more columns on larger screens if gridColumns > 2 */
	}
</style>
