---
import Hero from './Hero.astro';
import Icon from './Icon.astro';

interface CardItem {
	icon?: keyof typeof import('./IconPaths').iconPaths;
	title: string;
	content: string | string[];
}

interface GenericCardProps {
	// Hero section (optional)
	title?: string;
	tagline?: string;

	// Cards section
	cards: CardItem[];

	// Photo/Media section (optional)
	photo?: {
		src: string;
		alt: string;
		overlayText?: string;
		width?: string;
	};

	// Customization options
	sectionClass?: string;
	cardsClass?: string;
	gridColumns?: number;
	showIcons?: boolean;
}
---

<main class:list={['flex flex-col gap-8', Astro.props.sectionClass]}
	style={`--grid-columns: ${Astro.props.gridColumns || 1}`}>
	{ Astro.props.title && (
		<Hero title={Astro.props.title} tagline={Astro.props.tagline || ''} />
	)}

	{Astro.props.photo && (
		<section class="flex justify-center my-8">
			<div class="relative max-w-[64rem] rounded-3xl overflow-hidden shadow-2xl">
				<img
					width={Astro.props.photo.width || "1200px"}
					src={Astro.props.photo.src}
					alt={Astro.props.photo.alt}
					class="w-full h-auto block"
				/>
				{Astro.props.photo.overlayText && (
					<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-8 text-white">
						<p class="italic text-lg text-center m-0">{Astro.props.photo.overlayText}</p>
					</div>
				)}
			</div>
		</section>
	)}

	<section class:list={['grid gap-8 my-12', Astro.props.cardsClass]}
		style={`grid-template-columns: repeat(var(--grid-columns, 1), 1fr)`}>
		{Astro.props.cards.map((card: CardItem) => (
			<div class="flex flex-col items-start text-left p-8 border border-gray-800 rounded-3xl bg-black/5 backdrop-blur-sm transition-transform duration-300 ease-in-out hover:scale-[1.02]">
				{ (Astro.props.showIcons !== false && card.icon) && (
					<div class="mb-6 p-4 rounded-full bg-gradient-to-br from-gray-700 to-gray-900 shadow-md">
						<Icon icon={card.icon} color="var(--accent-regular)" size="2.5rem" />
					</div>
				)}
				<h3 class="text-xl font-semibold text-gray-0 mb-4">{card.title}</h3>
				<div class="text-gray-300 leading-6 text-left">
					{Array.isArray(card.content) ? (
						<>
							{card.content.map((paragraph: string) => (
								<p set:html={paragraph} class="mb-4 last:mb-0"></p>
							))}
						</>
					) : (
						<p set:html={card.content} class="mb-4 last:mb-0"></p>
					)}
				</div>
			</div>
		))}
	</section>

	
</main>

<style>
	/* Estilos críticos que no pueden expresarse con Tailwind */
	.card-content strong {
		color: var(--accent-regular);
		font-weight: 600;
	}
</style>
