---
// src/components/SectionCard.astro
interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<section class="card">
	<div class="card-header">
		<h3>{title}</h3>
		{description && <p class="description">{description}</p>}
	</div>
	<div class="card-content">
		<slot />
	</div>
</section>

<style>
	.card {
		border: 1px solid var(--gray-800);
		border-radius: 12px;
		padding: 1.5rem;
		margin-bottom: 2rem;
		background: var(--gray-999);
		box-shadow: var(--shadow-md);
	}
	h3 {
		margin: 0;
	}
	.description {
		color: var(--gray-400);
		margin: 0.5rem 0 1rem 0;
		font-size: var(--text-sm);
		line-height: 1.5;
	}
	.card-content :global(ul) {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.card-content :global(li) {
		padding-left: 1.5rem;
		position: relative;
		margin-bottom: 0.5rem;
		color: var(--gray-200);
	}
	.card-content :global(li::before) {
		content: '→';
		position: absolute;
		left: 0;
		color: var(--accent-regular);
	}
</style>
